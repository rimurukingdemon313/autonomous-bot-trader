# Copy to your platform's secret settings (Railway: Variables). NEVER commit real values.
MODE=PAPER                       # PAPER | DEMO   (LIVE is refused)
DATA_DIR=/data                   # mount a Railway Volume here: database + memory persist across deploys
PAPER_START_BALANCE=20000
SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,USDCHF,NZDUSD,EURGBP,EURJPY,GBPJPY,EURCHF,AUDJPY
DASHBOARD_TOKEN=                 # long random string; required for resume / clear-stop / scan

# TradeLocker (market data in PAPER; data + orders in DEMO). Secrets.
# Where prices come from (docs/OPERATIONS.md):
#   auto        = TradeLocker when its credentials below are set, otherwise no data
#   yahoo       = Yahoo Finance public prices, PAPER only: no broker, no account, no key.
#                 Yahoo gives one price per bar, so a typical spread per pair is ESTIMATED
#                 (override with PAPER_SPREAD_PIPS_EURUSD=0.8 etc.); FX volume is not published.
#   tradelocker = TradeLocker only
DATA_SOURCE=auto
# RISK_MAX_QUOTE_AGE_S=90        # default 30, or 90 with DATA_SOURCE=yahoo (its price carries its own time)
TRADELOCKER_EMAIL=
TRADELOCKER_PASSWORD=
TRADELOCKER_SERVER=
TRADELOCKER_ACCOUNT_ID=
TRADELOCKER_BASE_URL=https://demo.tradelocker.com/backend-api

# Who decides (docs/AI_MODELS.md):
#   evidence   = the quantitative system (default; the one PR-001 tested)
#   llm_trader = a language model analyses H1/H4/D1 and proposes trades; its own trade memory and
#                self-reviews shape later decisions; the risk engine still sizes and may refuse.
#                PAPER/DEMO only. Its win rate is measured forward, on the dashboard.
#   trading_room = one team, one mind per provider in AI_PROVIDERS, with roles in that order: TREND, PRICE,
#                NEWS (economic calendar), RISK. They discuss in turn and one writes the joint decision.
DECISION_MODE=evidence
# Trading room only (docs/AI_MODELS.md):
AI_ROOM_SIZE=4                   # members, taken from AI_PROVIDERS in order (1-8)
AI_ROOM_HEAD=                    # provider that writes the joint decision; empty = the first member present
TRADE_STYLE=                     # free (default: the team chooses) or scalp (the owner prefers M1 trades of about 1-5 minutes; still the team's call)
# How often the model-trader modes decide (docs/AI_MODELS.md). 0 = every 4th H1 close (the tested
# cadence; the evidence system refuses anything else). 1..240 = every N minutes.
DECISION_INTERVAL_MIN=0
# Pairs analysed per decision cycle, in rotation; 0 = all. With a short interval keep it small:
# every pair analysed costs language-model calls (up to 5 per pair in the trading room).
SYMBOLS_PER_CYCLE=0

# Language models. EITHER several providers, tried in order (when one fails, is rate-limited
# or its daily quota is spent, the next answers). Known names need only a key and a model:
#   openrouter, groq, xai (Grok), gemini, bytez
AI_PROVIDERS=                    # e.g. openrouter,groq,gemini,xai,bytez
AI_OPENROUTER_API_KEY=
AI_OPENROUTER_MODEL=
AI_GROQ_API_KEY=
AI_GROQ_MODEL=
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=
AI_XAI_API_KEY=
AI_XAI_MODEL=
AI_BYTEZ_API_KEY=
AI_BYTEZ_MODEL=
# optional per provider: AI_<NAME>_FALLBACK_MODELS, AI_<NAME>_DAILY_BUDGET, AI_<NAME>_BASE_URL
# OR one provider (the original form):
AI_PROVIDER=none                 # none | openai_compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_FALLBACK_MODELS=              # comma-separated, tried in order when the first fails
AI_MODEL_TRADER=                 # optional: a different model for the trader than for reviews
AI_MAX_TOKENS=1500               # per reply; raise for reasoning models
AI_TIMEOUT_S=60
AI_AGENTS=adversary,reviewer
AI_DAILY_CALL_BUDGET=500
AI_REQUIRED=false

# Risk (clamped: per-trade risk can never exceed 1%)
RISK_PER_TRADE_PCT=0.5
RISK_DAILY_LOSS_PCT=2.0
RISK_MAX_DRAWDOWN_PCT=8.0
RISK_MAX_OPEN_POSITIONS=3
# Funded-account rules: only if you have them (leave FUNDED_NAME empty otherwise)
FUNDED_NAME=
FUNDED_DAILY_LOSS_PCT=
FUNDED_MAX_LOSS_PCT=
FUNDED_TRAILING_DD_PCT=
FUNDED_MAX_RISK_PCT=
FUNDED_NO_WEEKEND=false
