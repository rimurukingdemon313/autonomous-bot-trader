# Copy to your platform's secret settings (Railway: Variables). NEVER commit real values.

# ═══ DUAL AI (docs/DUAL_AI.md): ONE OpenRouter key powers BOTH agents, FREE models only ═══
# Paste your key between the quotes. Locally: save this file as .env (it is in .gitignore, never committed) and
# start with   MODE=PAPER_FORWARD DECISION_MODE=dual_ai python -m aitrader
# On GitHub (the continuous paper run): add it as the Actions secret OPENROUTER_API_KEY instead.
OPENROUTER_API_KEY="PASTE_MY_KEY_HERE"
# OPENROUTER_VISION_MODEL=        # optional pin for Agent 1, used only while the catalog lists it as FREE
# OPENROUTER_JUDGE_MODEL=         # optional pin for Agent 2, same rule
# OPENROUTER_DAILY_CALL_BUDGET=900  # never above the key's own free daily quota (50, or 1000 after $10 of credits)
# OPENROUTER_TIMEOUT_S=120
# OPENROUTER_MAX_RETRIES=3

MODE=PAPER                       # PAPER only. DEMO and LIVE are refused: no broker is integrated
                                 # (TradeLocker was removed; a MetaTrader 5 adapter is planned once a
                                 # strategy shows positive forward evidence in paper)
# Safety switches (docs/OPERATIONS.md). Anything but true/false is refused at startup.
LIVE_TRADING=false               # must stay false: true is refused (there is no live path in this build)
PAPER_MODE=true                  # optional; false is refused (PAPER only)
EXPERIMENTAL_EXECUTE=false       # must stay false: true is refused at startup (takeover audit, docs/TAKEOVER_AUDIT.md).
                                 # PAPER simulates every trade; today every trade is EXPERIMENTAL.
# EXEC_MAX_DECISION_AGE_S=900    # a decision older than this is not executed (30..3600)
DATA_DIR=/data                   # mount a Railway Volume here: database + memory persist across deploys
PAPER_START_BALANCE=20000
SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,USDCHF,NZDUSD,EURGBP,EURJPY,GBPJPY,EURCHF,AUDJPY
DASHBOARD_TOKEN=                 # long random string; required for resume / clear-stop / scan

# Where prices come from (docs/OPERATIONS.md):
#   yahoo   = Yahoo Finance public prices (default): no broker, no account, no key.
#             Yahoo gives one price per bar, so a typical spread per pair is ESTIMATED
#             (override with PAPER_SPREAD_PIPS_EURUSD=0.8 etc.); FX volume is not published.
#   offline = no prices: the service runs and reports DATA: NOT CONNECTED, and never trades.
#   ("auto" is accepted as yahoo; "tradelocker" is refused.)
DATA_SOURCE=yahoo
# RISK_MAX_QUOTE_AGE_S=90        # default 90 with yahoo (its price carries its own time)

# Who decides (docs/AI_MODELS.md):
#   evidence   = the quantitative system (default; the one PR-001 tested)
#   llm_trader = a language model analyses H1/H4/D1 and proposes trades; its own trade memory and
#                self-reviews shape later decisions; the risk engine still sizes and may refuse.
#                PAPER only. Its win rate is measured forward, on the dashboard.
#   trading_room = one team, one mind per provider in AI_PROVIDERS, with roles in that order: TREND, PRICE,
#                NEWS (economic calendar), RISK. They discuss in turn and one writes the joint decision.
#   experimental_ai = the first provider PROPOSES (BUY/SELL/NO_TRADE/UNCERTAIN, confidence, evidence,
#                reasons against, invalidation); specialists on another provider CHALLENGE it; a fixed
#                rule decides. Every trade is tagged EXPERIMENTAL_AI. A model-proposed trade is SHADOW in
#                every mode, PAPER included: a language model may not create a trade.
#   edges      = only promoted, research-validated edges (none exist today: it will not trade)
#   dual_ai    = MODE=PAPER_FORWARD only (docs/DUAL_AI.md). A trading desk on free OpenRouter models: Trader 1
#                reads a chart image, Trader 2 (another model) analyses the raw data; each always chooses BUY
#                or SELL; the same side is an agreement, opposite sides are settled by one debate (a third
#                model). The risk engine sizes the trade and may refuse it. Needs OPENROUTER_API_KEY (above).
#                Suggested with a free key (50 requests a day): DECISION_INTERVAL_MIN=75, SYMBOLS_PER_CYCLE=1.
DECISION_MODE=evidence
# experimental_ai only: specialist roles, comma-separated, from structure,quant,price_action,macro,adversary.
# Each costs one model call per proposal. Empty = no specialists (an explicit choice).
AI_SPECIALISTS=adversary
# Trading room only (docs/AI_MODELS.md):
AI_ROOM_SIZE=4                   # members, taken from AI_PROVIDERS in order (1-8)
AI_ROOM_HEAD=                    # provider that writes the joint decision; empty = the first member present
TRADE_STYLE=                     # free (default: the team chooses) or scalp (the owner prefers M1 trades of about 1-5 minutes; still the team's call)
# How often the model-trader modes decide (docs/AI_MODELS.md). 0 = every 4th H1 close (the tested
# cadence; the evidence system refuses anything else). 1..240 = every N minutes.
DECISION_INTERVAL_MIN=0
# Pairs analysed per decision cycle, in rotation; 0 = all. With a short interval keep it small:
# every pair analysed costs language-model calls (up to 5 per pair in the trading room).
SYMBOLS_PER_CYCLE=0

# Language models. EITHER several providers, tried in order (when one fails, is rate-limited
# or its daily quota is spent, the next answers). Known names need only a key and a model:
#   openrouter, groq, xai (Grok), gemini, bytez
AI_PROVIDERS=                    # e.g. openrouter,groq,gemini,xai,bytez
AI_OPENROUTER_API_KEY=
AI_OPENROUTER_MODEL=
AI_GROQ_API_KEY=
AI_GROQ_MODEL=
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=
AI_XAI_API_KEY=
AI_XAI_MODEL=
AI_BYTEZ_API_KEY=
AI_BYTEZ_MODEL=
# optional per provider: AI_<NAME>_FALLBACK_MODELS, AI_<NAME>_DAILY_BUDGET, AI_<NAME>_BASE_URL, AI_<NAME>_MAX_TOKENS
# optional cost tracking (your price per million tokens; unset = shown as "not priced", never as 0):
#   AI_<NAME>_COST_IN_PER_MTOK=0.59  AI_<NAME>_COST_OUT_PER_MTOK=0.79
# Order matters: the first provider is PRIMARY, the next SECONDARY (the challenger in experimental_ai),
# the rest FALLBACK. If none answers validly, the decision is NO_TRADE (the deterministic fallback).
# OR one provider (the original form):
AI_PROVIDER=none                 # none | openai_compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_FALLBACK_MODELS=              # comma-separated, tried in order when the first fails
AI_MODEL_TRADER=                 # optional: a different model for the trader than for reviews
AI_MAX_TOKENS=1500               # per reply; raise for reasoning models
AI_TIMEOUT_S=60
AI_AGENTS=adversary,reviewer
AI_DAILY_CALL_BUDGET=500
AI_REQUIRED=false

# Risk. These can only TIGHTEN the built-in limits; a looser or non-positive value is refused at startup.
# While no edge is VALIDATED per-trade risk is capped at 0.25% (risk engine), whatever is set here.
RISK_PER_TRADE_PCT=0.25
RISK_DAILY_LOSS_PCT=2.0
RISK_WEEKLY_LOSS_PCT=4.0
RISK_MAX_OPEN_RISK_PCT=0.75
RISK_MAX_DRAWDOWN_PCT=8.0
RISK_MAX_OPEN_POSITIONS=3
# RISK_MAX_COST_TO_RISK=0.25   # round-trip cost (spread+commission+slippage) / stop distance; can only be lowered
# Funded-account rules: only if you have them (leave FUNDED_NAME empty otherwise)
FUNDED_NAME=
FUNDED_DAILY_LOSS_PCT=
FUNDED_MAX_LOSS_PCT=
FUNDED_TRAILING_DD_PCT=
FUNDED_MAX_RISK_PCT=
FUNDED_NO_WEEKEND=false
