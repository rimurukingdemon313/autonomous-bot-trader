# Copy to your platform's secret settings (Railway: Variables). NEVER commit real values.
MODE=PAPER                       # PAPER | DEMO   (LIVE is refused)
DATA_DIR=/data                   # mount a Railway Volume here: database + memory persist across deploys
PAPER_START_BALANCE=20000
SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,USDCHF,NZDUSD,EURGBP,EURJPY,GBPJPY,EURCHF,AUDJPY
DASHBOARD_TOKEN=                 # long random string; required for resume / clear-stop / scan

# TradeLocker (market data in PAPER; data + orders in DEMO). Secrets.
TRADELOCKER_EMAIL=
TRADELOCKER_PASSWORD=
TRADELOCKER_SERVER=
TRADELOCKER_ACCOUNT_ID=
TRADELOCKER_BASE_URL=https://demo.tradelocker.com/backend-api

# Optional language-model layer (docs/AI_MODELS.md). Off by default.
AI_PROVIDER=none                 # none | openai_compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_AGENTS=adversary,reviewer
AI_DAILY_CALL_BUDGET=500
AI_REQUIRED=false

# Risk (clamped: per-trade risk can never exceed 1%)
RISK_PER_TRADE_PCT=0.5
RISK_DAILY_LOSS_PCT=2.0
RISK_MAX_DRAWDOWN_PCT=8.0
RISK_MAX_OPEN_POSITIONS=3
# Funded-account rules: only if you have them (leave FUNDED_NAME empty otherwise)
FUNDED_NAME=
FUNDED_DAILY_LOSS_PCT=
FUNDED_MAX_LOSS_PCT=
FUNDED_TRAILING_DD_PCT=
FUNDED_MAX_RISK_PCT=
FUNDED_NO_WEEKEND=false
