# ── Secrets: never committed (SECURITY_CONTRACT.md) ──
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials*
*secret*
!SECURITY_CONTRACT.md

# ── Data: raw and derived files are not committed; manifests and READMEs are ──
data/*
!data/README.md
!data/manifest.json
!data/external/
data/external/*
!data/external/manifest.json
!data/rates/
data/rates/*
!data/rates/manifest.json
!data/cot/
data/cot/*
!data/cot/manifest.json
!data/h10/
data/h10/*
!data/h10/manifest.json
*.csv
*.parquet
*.feather
*.h5
*.hdf5
*.db
*.sqlite
*.sqlite3

# ── Model artifacts: hashes and cards are committed, binaries are not ──
models/*
!models/README.md
!models/artifacts/
*.pkl
*.joblib
*.onnx
*.pt
*.bin

# ── Runtime and tooling ──
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
node_modules/
dist/
build/
*.log
logs/
.runtime/
.DS_Store
.idea/
.vscode/
!data/div/
data/div/*
!data/div/manifest.json
!data/div2/
data/div2/*
!data/div2/manifest.json
!data/div2/policy_rates.csv
!data/rc/
data/rc/*
!data/rc/policy_rates.csv
!data/rc/manifest.json
